# Copy to .env and fill in real values. Never commit .env itself.

NODE_ENV=development
PORT=3000

# Only "password" is supported.
DATABASE_AUTH_MODE=password

# Local Postgres by default. For AWS RDS, swap the host/credentials — SSL is
# handled automatically by DATABASE_SSL below, no other change needed.
DATABASE_URL=postgresql://user:password@localhost:5432/eclat

# "auto" = SSL (verified against Node's default trusted root store — covers
# RDS/Aurora certs issued by Amazon Trust Services) when NODE_ENV=production,
# off otherwise. "require" to test against RDS from a dev machine, "disable" to
# force it off (e.g. a local Postgres that doesn't speak SSL at all).
DATABASE_SSL=auto

# openssl rand -hex 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_WINDOW=5
OTP_WINDOW_MINUTES=10
