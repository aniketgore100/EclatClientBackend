# # Copy to .env and fill in real values. Never commit .env itself.

# NODE_ENV=development
# PORT=3000

# DATABASE_AUTH_MODE=password


# DATABASE_URL=postgresql://user:password@localhost:5432/eclat


# DATABASE_SSL=auto

# # openssl rand -hex 48
# JWT_ACCESS_SECRET=
# JWT_ACCESS_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30

# OTP_TTL_MINUTES=5
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_PER_WINDOW=5
# OTP_WINDOW_MINUTES=10

# --- Razorpay ---
# Test-mode keys in development, live keys in production. The key SECRET and webhook secret must
# never reach the browser; only the key ID is sent to the storefront.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Secret set on the dashboard webhook → https://<host>/v1/webhooks/razorpay
# (events: payment.captured, payment.failed, order.paid, refund.processed, refund.failed)
# RAZORPAY_WEBHOOK_SECRET=
# Dev/test only: "fake" runs payments against a local stand-in gateway. Refused when NODE_ENV=production.
# PAYMENT_GATEWAY=razorpay

# --- Shipping webhook (Shiprocket) ---
# Token Shiprocket sends in the x-api-key header of its tracking webhook (https://<host>/v1/webhooks/courier).
# The URL must not contain "shiprocket", "kartrocket", "sr" or "kr". Generate one with: openssl rand -hex 24
# SHIPROCKET_WEBHOOK_TOKEN=
