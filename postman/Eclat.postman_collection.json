{
  "info": {
    "name": "Eclat API",
    "_postman_id": "e6c1a1e0-0000-4000-8000-000000000001",
    "description": "Eclat storefront backend. Import this file into Postman, then set the `baseUrl` collection variable (defaults to http://localhost:3000). Run `npm run dev` and `npm run db:seed` first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "categorySlug", "value": "necklaces", "type": "string" },
    { "key": "productSlug", "value": "neer-freshwater-pearl-necklace", "type": "string" },
    { "key": "contentKey", "value": "home.hero", "type": "string" },
    { "key": "phone", "value": "+919876500001", "type": "string" },
    { "key": "otp", "value": "000000", "type": "string", "description": "Static in non-production (NODE_ENV != production) — always 000000, no need to check server logs. Will be a real code once a provider is wired up and this runs in production." },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Phone-OTP customer auth (PRD §2, §11C). No password/Google login — see Eclat_PRD_v1.2.md. Run requests in order: Send OTP → copy the code from the server console into the `otp` collection variable → Verify OTP (captures accessToken/refreshToken automatically) → Me / Refresh / Logout.",
      "item": [
        {
          "name": "1. Send OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"{{phone}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/auth/otp/send", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "otp", "send"] },
            "description": "202 with expiresInSeconds. The actual code is only logged server-side (console) in non-production — copy it into the `otp` variable before running Verify OTP."
          },
          "response": []
        },
        {
          "name": "1b. Send OTP — resend too soon (429 cooldown)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"{{phone}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/auth/otp/send", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "otp", "send"] },
            "description": "Run this immediately after '1. Send OTP' for the same phone — expect 429 OTP_COOLDOWN."
          },
          "response": []
        },
        {
          "name": "1c. Send OTP — invalid phone (400 validation)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"not-a-phone\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/auth/otp/send", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "otp", "send"] }
          },
          "response": []
        },
        {
          "name": "2. Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.data.refreshToken);",
                  "}",
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"otp\": \"{{otp}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/auth/otp/verify", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "otp", "verify"] },
            "description": "Set the `otp` collection variable to the code from the server console first. On success, this test script auto-saves accessToken/refreshToken into collection variables for the requests below."
          },
          "response": []
        },
        {
          "name": "2b. Verify OTP — wrong code (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"otp\": \"111111\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/auth/otp/verify", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "otp", "verify"] },
            "description": "111111 is deliberately wrong — 000000 is now the valid dev/test code (see 'otp' variable), so it can't be used here. Run against a phone with a still-pending OTP. Repeat 5x to also see OTP_MAX_ATTEMPTS (429) on the 6th try."
          },
          "response": []
        },
        {
          "name": "3. Get current customer (/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "me"] },
            "description": "Requires accessToken from step 2. Proves the JWT + requireAuth middleware works."
          },
          "response": []
        },
        {
          "name": "3b. Get current customer — no token (401)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "me"] }
          },
          "response": []
        },
        {
          "name": "4. Refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "refresh-token"] },
            "description": "Rotates the refresh token — the old one becomes invalid immediately (run '4b' after this to see that)."
          },
          "response": []
        },
        {
          "name": "4b. Refresh token — malformed token (401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"not-a-real-token\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "refresh-token"] }
          },
          "response": []
        },
        {
          "name": "5. Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/auth/logout", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "logout"] },
            "description": "204 on success. Run '4. Refresh token' again afterward with the same token to confirm it's rejected (401)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Catalogue",
      "item": [
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/v1/catalogue/categories", "host": ["{{baseUrl}}"], "path": ["v1", "catalogue", "categories"] }
          },
          "response": []
        },
        {
          "name": "Get category by slug",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/catalogue/categories/{{categorySlug}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "catalogue", "categories", "{{categorySlug}}"]
            }
          },
          "response": []
        },
        {
          "name": "Get category by slug — not found",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/catalogue/categories/does-not-exist",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "catalogue", "categories", "does-not-exist"]
            }
          },
          "response": []
        },
        {
          "name": "List products (default)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/catalogue/products",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "catalogue", "products"]
            }
          },
          "response": []
        },
        {
          "name": "List products — filtered + sorted + paginated",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/catalogue/products?category={{categorySlug}}&sort=price_asc&page=1&limit=12&inStock=true",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "catalogue", "products"],
              "query": [
                { "key": "category", "value": "{{categorySlug}}" },
                { "key": "sort", "value": "price_asc" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "12" },
                { "key": "inStock", "value": "true" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "List products — invalid query (validation error)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/catalogue/products?sort=not-a-real-sort",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "catalogue", "products"],
              "query": [{ "key": "sort", "value": "not-a-real-sort" }]
            }
          },
          "response": []
        },
        {
          "name": "Get product by slug",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/catalogue/products/{{productSlug}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "catalogue", "products", "{{productSlug}}"]
            }
          },
          "response": []
        },
        {
          "name": "Get product by slug — not found",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/catalogue/products/does-not-exist",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "catalogue", "products", "does-not-exist"]
            }
          },
          "response": []
        },
        {
          "name": "Get home content",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/v1/catalogue/content/home", "host": ["{{baseUrl}}"], "path": ["v1", "catalogue", "content", "home"] }
          },
          "response": []
        },
        {
          "name": "Get content by key",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/catalogue/content/{{contentKey}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "catalogue", "content", "{{contentKey}}"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
