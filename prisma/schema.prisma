generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum VariantStatus {
  ACTIVE
  ARCHIVED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Category {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  image       String?
  description String?
  position    Int           @default(0)
  status      ProductStatus @default(ACTIVE)
  products    Product[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  name        String
  slug        String        @unique
  subtitle    String?
  description String?
  status      ProductStatus @default(DRAFT)
  // Storefront collection slugs (e.g. "new-drops", "bestsellers") — a product
  // belongs to a collection by carrying its slug here.
  tags        String[]      @default([])
  // "new" | "bestseller" | "limited"
  badges      String[]      @default([])
  // "Featured" sort order on the storefront — lower comes first.
  sortOrder   Int           @default(0)

  // Product page accordions. Shipping copy is store-wide, not per product.
  material String?
  care     String?

  seoTitle String?
  seoMeta  String?

  codAllowed Boolean @default(true)

  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  images      ProductImage[]
  optionTypes OptionType[]
  variants    Variant[]
  reviews     Review[]
  attributes  ProductAttribute[]
  wishlisted  WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  // "model" (worn) or "packshot" (on a plain background). The first image is
  // the storefront card image and should be a model shot.
  kind      String   @default("packshot")
  position  Int      @default(0)
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id])

  @@index([productId])
  @@map("product_images")
}

// Free-form per-product spec rows (e.g. "Chain Length" on a necklace,
// "Post Type" on an earring) — deliberately not fixed columns, since which
// properties apply varies by product/category. Admin adds exactly the rows
// that make sense for a given piece; the PDP renders whatever's there.
model ProductAttribute {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  value     String
  position  Int     @default(0)

  @@index([productId])
  @@map("product_attributes")
}

model OptionType {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String

  @@index([productId])
  @@map("option_types")
}

model Variant {
  id        String        @id @default(uuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String        @unique
  options   Json
  price     Int
  mrp       Int
  weightG   Float?
  dims      Json?
  barcode   String?
  status    VariantStatus @default(ACTIVE)

  images     ProductImage[]
  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("variants")
}

model Inventory {
  variantId         String  @id
  variant           Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  onHand            Int     @default(0)
  reserved          Int     @default(0)
  lowStockThreshold Int     @default(5)

  @@map("inventory")
}

enum OtpPurpose {
  LOGIN
  REGISTER
  CHANGE_PHONE
}

enum AuthProvider {
  PHONE
}

model Customer {
  id            String         @id @default(uuid())
  phone         String         @unique
  email         String?
  name          String?
  dob           DateTime?
  whatsappOptIn Boolean        @default(false)
  tags          String[]       @default([])
  addresses     Address[]
  reviews       Review[]
  sessions      AuthSession[]
  cart          Cart?
  wishlist      WishlistItem[]
  orders        Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

model OtpVerification {
  id String @id @default(uuid())

  phone   String
  purpose OtpPurpose @default(LOGIN)

  codeHash String

  expiresAt  DateTime
  verifiedAt DateTime?

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  createdAt DateTime @default(now())

  @@index([phone, purpose])
  @@index([expiresAt])
  @@map("otp_verifications")
}

model AuthSession {
  id               String    @id @default(uuid())
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Address {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String
  pincode    String
  type       String   @default("home")
  isDefault  Boolean  @default(false)

  @@index([customerId])
  @@map("addresses")
}

// One cart per customer, created on first use. Guests keep theirs in the browser until login,
// when it is merged in (see cart.service). Prices are never stored here — a line is just
// variant + quantity, priced from the variant on every read.
model Cart {
  id         String     @id @default(uuid())
  customerId String     @unique
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

model WishlistItem {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([productId])
  @@map("wishlist_items")
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  ONLINE
  COD
}

// All money is in paise. Everything a customer sees on an order (names, prices, address) is
// snapshotted here, so later catalogue or address edits never rewrite history.
model Order {
  id         String   @id @default(uuid())
  number     String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  status        OrderStatus
  paymentMethod PaymentMethod

  subtotal    Int
  shippingFee Int
  codFee      Int
  total       Int
  currency    String @default("INR")

  shippingMethod  String
  contactEmail    String
  contactPhone    String
  marketingOptIn  Boolean @default(false)
  shippingAddress Json
  giftNote        String?

  // Online orders hold their stock (inventory.reserved) until paid; past this time the hold is released.
  holdExpiresAt DateTime?

  // Client-generated key for one checkout attempt: a retry of the same attempt returns this order
  // instead of creating a second one.
  idempotencyKey String?

  paidAt       DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  shippedAt    DateTime?
  deliveredAt  DateTime?

  // Where the order was placed from, read from the browser's User-Agent at checkout. Null on orders
  // placed before this was recorded (shown as "Unknown" in the admin).
  deviceType String? // "mobile" | "tablet" | "desktop"
  os         String?
  browser    String?
  userAgent  String?

  items     OrderItem[]
  payments  Payment[]
  shipments Shipment[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([customerId, idempotencyKey])
  @@index([createdAt])
  @@index([customerId, createdAt])
  @@index([status, holdExpiresAt])
  @@map("orders")
}

enum PaymentStatus {
  CREATED
  CAPTURED
  FAILED
  REFUND_PENDING
  REFUNDED
}

// One row per gateway order (Razorpay lets the customer try several times against the same order;
// the latest attempt's details live here). Amounts are paise.
model Payment {
  id                String        @id @default(uuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String        @default("razorpay")
  providerOrderId   String        @unique
  providerPaymentId String?       @unique
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  method            String?
  failureCode       String?
  failureReason     String?
  refundId          String?
  refundedAmount    Int           @default(0)
  capturedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
  @@index([status, createdAt])
  @@map("payments")
}

// Gateway webhook deliveries already handled, keyed by the provider's event id, so a redelivery is a no-op.
model WebhookEvent {
  id          String   @id
  provider    String
  type        String
  processedAt DateTime @default(now())

  @@map("webhook_events")
}

enum ShipmentStatus {
  CREATED // order exists at the courier platform, no courier yet
  AWB_ASSIGNED // courier booked, tracking number issued
  PICKUP_SCHEDULED // courier asked to collect
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RTO // returning to us
  CANCELLED
}

// One shipment of an order at the courier platform (Shiprocket). Creating one is a multi-step,
// resumable process, so every id and the furthest step reached are saved as they happen.
model Shipment {
  id                 String          @id @default(uuid())
  orderId            String
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider           String          @default("shiprocket")
  providerOrderId    String?         @unique
  providerShipmentId String?         @unique
  status             ShipmentStatus  @default(CREATED)
  // The platform's own wording for the latest status (e.g. "IN TRANSIT"), kept for the admin.
  rawStatus          String?
  courierId          Int?
  courierName        String?
  awb                String?         @unique
  labelUrl           String?
  trackingUrl        String?
  weightG            Int?
  dims               Json?
  freightCharge      Int? // paise, as quoted when the courier was chosen
  pickupScheduledAt  DateTime?
  etd                DateTime?
  deliveredAt        DateTime?
  lastError          String?
  // Held briefly while one admin's "ship" is running, so a double-click can't create two parcels.
  lockedAt           DateTime?
  events             ShipmentEvent[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("shipments")
}

// Tracking scans, deduplicated by a fingerprint so a webhook redelivery adds nothing.
model ShipmentEvent {
  id          String   @id @default(uuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  fingerprint String
  status      String
  activity    String?
  location    String?
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  @@unique([shipmentId, fingerprint])
  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sku          String
  name         String
  slug         String
  optionsLabel String
  imageUrl     String?
  unitPrice    Int
  quantity     Int

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

enum InventoryMovementType {
  INITIAL
  RESERVE
  RELEASE
  SALE
  RESTOCK
  ADJUSTMENT
}

// Append-only record of every stock change, so on-hand/reserved can always be explained and
// reconciled. Deliberately has no FK to variants — history outlives a deleted variant.
model InventoryMovement {
  id            String                @id @default(uuid())
  variantId     String
  orderId       String?
  type          InventoryMovementType
  onHandDelta   Int                   @default(0)
  reservedDelta Int                   @default(0)
  note          String?
  createdAt     DateTime              @default(now())

  @@index([variantId, createdAt])
  @@index([orderId])
  @@map("inventory_movements")
}

model Review {
  id         String       @id @default(uuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id])
  orderId    String?
  rating     Int
  title      String?
  text       String?
  photos     String[]     @default([])
  status     ReviewStatus @default(PENDING)
  reply      String?
  createdAt  DateTime     @default(now())

  @@index([productId])
  @@map("reviews")
}

// The website's editable content: ONE document holding the homepage sections and the site chrome
// (announcement bar, menus, footer…). The admin edits `draft`; the storefront serves `published`.
// Publishing copies draft → published and files the old version in site_revisions, so any publish
// can be rolled back. `version` is bumped on every draft save so two editors can't silently overwrite
// each other.
model SiteContent {
  id          String    @id // always "site"
  draft       Json
  published   Json?
  version     Int       @default(1)
  publishedAt DateTime?
  publishedBy String?
  updatedBy   String?
  updatedAt   DateTime  @updatedAt

  @@map("site_content")
}

model SiteRevision {
  id          String   @id @default(uuid())
  snapshot    Json
  note        String?
  publishedBy String?
  publishedAt DateTime @default(now())

  @@index([publishedAt])
  @@map("site_revisions")
}

// Lets the admin's Preview button open the real storefront showing the DRAFT. Short-lived and random;
// both backends share the database so no secret has to be coordinated between them.
model SitePreviewToken {
  token     String   @id @default(uuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("site_preview_tokens")
}

enum AdminRole {
  OWNER
  STAFF
}

model AdminUser {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  role         AdminRole      @default(STAFF)
  active       Boolean        @default(true)
  sessions     AdminSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

model AdminSession {
  id               String    @id @default(uuid())
  adminUserId      String
  adminUser        AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_sessions")
}
